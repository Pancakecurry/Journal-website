# Public values identify a Supabase project; RLS must protect all exposed tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only AI adapter. Both values are required. A configured key
# does not enable AI: the user must grant scoped consent in the app first.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_CONSENT_SECRET=
AI_GENERATION_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=512

# Never expose service-role or secret keys through NEXT_PUBLIC_* variables.
# Server secrets are intentionally absent until a server-only use case is approved.
