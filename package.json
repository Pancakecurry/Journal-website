{
  "name": "campus-atelier-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, Day-centered journaling application foundation.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:pwa": "vitest run src/application/pwa-release.test.ts && playwright test tests/e2e/release-readiness.spec.ts",
    "test:db": "supabase test db",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:release": "npm run verify && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "dexie": "4.4.4",
    "fflate": "0.8.2",
    "motion": "13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
